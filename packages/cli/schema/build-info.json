{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build info 1.0",
  "description": "`.video-build/build-info.json` (task 049, PRD §11.1): what produced the last successful render. Hashes are lowercase hex SHA-256 of the exact bytes. `tools` holds the version each probe reported, or null when it did not run. Written by packages/cli/src/build-info.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "irSchemaVersion", "irHash", "assets", "tools", "platform", "flags"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "irSchemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "irHash": { "$ref": "#/$defs/sha256" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["video", "validator", "renderer", "node", "quarto", "pandoc", "remotion", "browser", "ffmpeg"],
      "properties": {
        "video": { "$ref": "#/$defs/version" },
        "validator": { "$ref": "#/$defs/version" },
        "renderer": { "$ref": "#/$defs/version" },
        "node": { "$ref": "#/$defs/version" },
        "quarto": { "$ref": "#/$defs/version" },
        "pandoc": { "$ref": "#/$defs/version" },
        "remotion": { "$ref": "#/$defs/version" },
        "browser": { "$ref": "#/$defs/version" },
        "ffmpeg": { "$ref": "#/$defs/version" }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "release", "arch"],
      "properties": {
        "os": { "type": "string", "minLength": 1 },
        "release": { "type": "string", "minLength": 1 },
        "arch": { "type": "string", "minLength": 1 }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["json", "theme"],
      "properties": {
        "json": { "type": "boolean" },
        "theme": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": ["string", "null"], "minLength": 1 },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "enum": ["footage", "image", "music", "captions", "device-frame"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Project-relative path (footage, image, music, captions), or repository-relative for a device frame definition (packages/registry/frames)."
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
