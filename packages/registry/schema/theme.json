{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quarto-video.local/registry/theme.json",
  "title": "Theme tokens",
  "description": "Design tokens of one named theme (PRD §10). Static data only: no functions, no CSS, no pixels in component code. Sizes are integers in output pixels at the frame size the renderer draws.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "purpose",
    "colors",
    "contrastPairs",
    "typography",
    "space",
    "radius",
    "safeArea",
    "motion"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "colors": {
      "$ref": "#/$defs/colors"
    },
    "contrastPairs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "background"],
        "properties": {
          "text": {
            "$ref": "#/$defs/colorName"
          },
          "background": {
            "$ref": "#/$defs/colorName"
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fontFamily", "weights", "scale", "lineHeight"],
      "properties": {
        "fontFamily": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9 ]{0,63}$"
        },
        "weights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["regular", "semibold", "bold"],
          "properties": {
            "regular": {
              "$ref": "#/$defs/weight"
            },
            "semibold": {
              "$ref": "#/$defs/weight"
            },
            "bold": {
              "$ref": "#/$defs/weight"
            }
          }
        },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caption", "body", "subtitle", "title"],
          "properties": {
            "caption": {
              "$ref": "#/$defs/fontSize"
            },
            "body": {
              "$ref": "#/$defs/fontSize"
            },
            "subtitle": {
              "$ref": "#/$defs/fontSize"
            },
            "title": {
              "$ref": "#/$defs/fontSize"
            }
          }
        },
        "lineHeight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tight", "body"],
          "properties": {
            "tight": {
              "$ref": "#/$defs/ratio"
            },
            "body": {
              "$ref": "#/$defs/ratio"
            }
          }
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xs", "sm", "md", "lg"],
      "properties": {
        "xs": {
          "$ref": "#/$defs/size"
        },
        "sm": {
          "$ref": "#/$defs/size"
        },
        "md": {
          "$ref": "#/$defs/size"
        },
        "lg": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "radius": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sm", "md"],
      "properties": {
        "sm": {
          "$ref": "#/$defs/size"
        },
        "md": {
          "$ref": "#/$defs/size"
        }
      }
    },
    "safeArea": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[1-9][0-9]*:[1-9][0-9]*$",
        "maxLength": 16
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["xPercent", "yPercent"],
        "properties": {
          "xPercent": {
            "$ref": "#/$defs/percent"
          },
          "yPercent": {
            "$ref": "#/$defs/percent"
          }
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fastMs", "baseMs", "slowMs"],
      "properties": {
        "fastMs": {
          "$ref": "#/$defs/milliseconds"
        },
        "baseMs": {
          "$ref": "#/$defs/milliseconds"
        },
        "slowMs": {
          "$ref": "#/$defs/milliseconds"
        }
      }
    }
  },
  "$defs": {
    "colorName": {
      "enum": ["background", "surface", "text", "mutedText", "accent"]
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "surface", "text", "mutedText", "accent"],
      "properties": {
        "background": {
          "$ref": "#/$defs/hex"
        },
        "surface": {
          "$ref": "#/$defs/hex"
        },
        "text": {
          "$ref": "#/$defs/hex"
        },
        "mutedText": {
          "$ref": "#/$defs/hex"
        },
        "accent": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "weight": {
      "type": "integer",
      "minimum": 100,
      "maximum": 900
    },
    "fontSize": {
      "type": "integer",
      "minimum": 8,
      "maximum": 400
    },
    "ratio": {
      "type": "number",
      "minimum": 1,
      "maximum": 2.5
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 400
    },
    "percent": {
      "type": "integer",
      "minimum": 0,
      "maximum": 25
    },
    "milliseconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    }
  }
}
