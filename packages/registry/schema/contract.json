{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quarto-video.local/registry/contract.json",
  "title": "Component contract",
  "description": "Data contract of one component (PRD §5.5). Static data only: no functions, no pixels, no CSS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "purpose",
    "slots",
    "props",
    "placements",
    "compatibleAnimations",
    "compatibleTransitions",
    "duration",
    "accessibility"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/slot"
      }
    },
    "props": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/prop"
      }
    },
    "placements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["background", "framed"]
      }
    },
    "compatibleAnimations": {
      "$ref": "#/$defs/idList"
    },
    "compatibleTransitions": {
      "$ref": "#/$defs/idList"
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minMs", "maxMs"],
      "properties": {
        "minMs": { "type": "integer", "minimum": 1 },
        "maxMs": { "type": "integer", "minimum": 1 }
      }
    },
    "accessibility": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "textFit": {
      "$ref": "#/$defs/textFit"
    }
  },
  "$defs": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "accepts"],
      "properties": {
        "required": { "type": "boolean" },
        "accepts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["paragraph", "heading", "list", "code-block", "image"]
          }
        },
        "maxBlocks": { "type": "integer", "minimum": 1, "maximum": 100 },
        "alternative": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "maxLength": 64
        },
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minItems", "maxItems"],
          "properties": {
            "minItems": { "type": "integer", "minimum": 1 },
            "maxItems": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["string", "boolean", "enum", "number", "csv", "column"]
        },
        "min": {
          "type": "number",
          "description": "For number: the smallest allowed value (inclusive). ADR-0015."
        },
        "max": {
          "type": "number",
          "description": "For number: the largest allowed value (inclusive). ADR-0015."
        },
        "integer": {
          "type": "boolean",
          "description": "For number: the value must be a whole number. ADR-0015."
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required": { "type": "boolean" },
        "of": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$",
          "maxLength": 64
        },
        "numeric": { "type": "boolean" },
        "default": {}
      },
      "allOf": [
        {
          "if": {
            "required": ["type"],
            "properties": { "type": { "const": "number" } }
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["min"], "properties": { "min": {} } },
                { "required": ["max"], "properties": { "max": {} } },
                { "required": ["integer"], "properties": { "integer": {} } }
              ]
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "enum" } } },
          "then": {
            "required": ["enum"],
            "properties": { "enum": { "type": "array" } }
          },
          "else": { "not": { "required": ["enum"] } }
        },
        {
          "if": { "properties": { "type": { "const": "column" } } },
          "then": {
            "required": ["of"],
            "properties": { "of": { "type": "string" } }
          },
          "else": {
            "not": {
              "required": ["of"],
              "properties": { "of": { "type": "string" } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "column" } } },
          "else": {
            "not": {
              "required": ["numeric"],
              "properties": { "numeric": { "type": "boolean" } }
            }
          }
        }
      ]
    },
    "textFit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "min"],
      "properties": {
        "max": { "$ref": "#/$defs/scaleName" },
        "min": { "$ref": "#/$defs/scaleName" },
        "subtitle": { "$ref": "#/$defs/textRange" }
      }
    },
    "textRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "min"],
      "properties": {
        "max": { "$ref": "#/$defs/scaleName" },
        "min": { "$ref": "#/$defs/scaleName" }
      }
    },
    "scaleName": {
      "enum": ["caption", "body", "subtitle", "title"]
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$",
        "maxLength": 64
      }
    }
  }
}
