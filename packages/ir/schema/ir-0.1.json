{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video IR 0.1",
  "description": "Renderer-independent video manifest. Time values are integer frames.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "type", "settings", "scenes"],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "type": {
      "const": "video"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "background"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "component", "durationFrames", "content", "source"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "component": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "durationFrames": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "text": { "type": "string", "minLength": 1 }
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": {
                "type": "string",
                "pattern": "^(?![/\\\\]).+$"
              }
            }
          }
        }
      }
    }
  }
}
