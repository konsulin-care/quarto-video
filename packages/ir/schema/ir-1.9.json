{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video IR 1.9",
  "description": "Video IR 1.9 (ADR-0017, task 045). Adds an optional top-level `music`: the project's one background track, with a project-relative file, a linear volume, a loop flag, an optional fade-out in frames and the file length in frames, which the validator writes. Version 1.8 (ADR-0009) is unchanged. Renderer-independent: no executable code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "settings",
    "scenes",
    "timeline",
    "generator"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.9"
    },
    "type": {
      "const": "video"
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "fps", "background"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "reducedMotion": {
          "type": "boolean",
          "description": "Reduced motion (task 023, ADR-0012): each animation and transition draws its preset's reducedMotion rule. Absent means false."
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "timeline": {
      "$ref": "#/$defs/timeline"
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "music": {
      "$ref": "#/$defs/music"
    }
  },
  "$defs": {
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "component", "durationFrames", "content", "source"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "component": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "transition": {
          "$ref": "#/$defs/transition"
        },
        "animation": {
          "$ref": "#/$defs/animation"
        },
        "props": {
          "$ref": "#/$defs/props"
        },
        "tables": {
          "$ref": "#/$defs/tables"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file"],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^(?![/\\\\]).+$"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "media": {
          "$ref": "#/$defs/media"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "durationFrames"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        }
      }
    },
    "props": {
      "type": "object",
      "description": "Component props (task 035, ADR-0014; numbers ADR-0015). Text as written, or a number the validator wrote from a number prop. The validator checks them against the component contract.",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 4000
          },
          {
            "type": "number"
          }
        ]
      }
    },
    "tables": {
      "type": "object",
      "description": "Data tables read from CSV props, keyed by prop name. Written by the validator (stage 3), never by the filter.",
      "propertyNames": {
        "pattern": "^[a-z][a-zA-Z0-9]*$",
        "maxLength": 64
      },
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns", "rows"],
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationFrames", "scenes"],
      "properties": {
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "startFrame"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension", "cli"],
      "properties": {
        "extension": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        },
        "cli": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots"],
      "properties": {
        "slots": {
          "type": "object",
          "patternProperties": {
            "^[a-z][a-z0-9-]{0,63}$": {
              "$ref": "#/$defs/slot"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "slot": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/paragraph"
        },
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/list"
        },
        {
          "$ref": "#/$defs/codeBlock"
        },
        {
          "$ref": "#/$defs/imageBlock"
        }
      ]
    },
    "inline": {
      "oneOf": [
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/strong"
        },
        {
          "$ref": "#/$defs/emphasis"
        },
        {
          "$ref": "#/$defs/quoted"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/lineBreak"
        }
      ]
    },
    "inlines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/inline"
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "inlines"],
      "properties": {
        "type": {
          "const": "paragraph"
        },
        "inlines": {
          "$ref": "#/$defs/inlines"
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "inlines"],
      "properties": {
        "type": {
          "const": "heading"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "inlines": {
          "$ref": "#/$defs/inlines"
        }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ordered", "items"],
      "properties": {
        "type": {
          "const": "list"
        },
        "ordered": {
          "type": "boolean"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["blocks"],
            "properties": {
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/block"
                }
              }
            }
          }
        }
      }
    },
    "codeBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "const": "code-block"
        },
        "text": {
          "type": "string"
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "imageBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "src", "fit", "alt"],
      "properties": {
        "type": {
          "const": "image"
        },
        "src": {
          "type": "string",
          "minLength": 1
        },
        "fit": {
          "enum": ["cover", "contain"]
        },
        "alt": {
          "type": "string"
        }
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "strong": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "inlines"],
      "properties": {
        "type": {
          "const": "strong"
        },
        "inlines": {
          "$ref": "#/$defs/inlines"
        }
      }
    },
    "emphasis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "inlines"],
      "properties": {
        "type": {
          "const": "emphasis"
        },
        "inlines": {
          "$ref": "#/$defs/inlines"
        }
      }
    },
    "quoted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "quote", "inlines"],
      "properties": {
        "type": {
          "const": "quoted"
        },
        "quote": {
          "enum": ["double", "single"]
        },
        "inlines": {
          "$ref": "#/$defs/inlines"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": {
          "const": "code"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "lineBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "line-break"
        }
      }
    },
    "media": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/mediaItem"
      }
    },
    "mediaItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "src",
        "placement",
        "fit",
        "sourceStartFrames",
        "audio",
        "loop",
        "freeze",
        "playbackRate",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "video"
        },
        "src": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\]).+$"
        },
        "placement": {
          "enum": ["background", "framed", "region"]
        },
        "fit": {
          "enum": ["cover", "contain"]
        },
        "frame": {
          "enum": ["browser", "phone", "tablet", "generic"]
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sourceStartFrames": {
          "type": "integer",
          "minimum": 0
        },
        "sourceEndFrames": {
          "type": "integer",
          "minimum": 1
        },
        "audio": {
          "enum": ["mute", "keep"]
        },
        "loop": {
          "type": "boolean"
        },
        "freeze": {
          "type": "boolean"
        },
        "playbackRate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "alt": {
          "type": "string"
        },
        "volume": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "placement": {
                "const": "region"
              }
            },
            "required": ["placement"]
          },
          "then": {
            "required": ["region"],
            "properties": {
              "region": true,
              "frame": false
            }
          },
          "else": {
            "properties": {
              "region": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "audio": {
                "const": "keep"
              }
            },
            "required": ["audio"]
          },
          "then": {
            "required": ["volume"],
            "properties": {
              "volume": true
            }
          },
          "else": {
            "properties": {
              "volume": false
            }
          }
        }
      ]
    },
    "music": {
      "type": "object",
      "description": "The project background music track (ADR-0017). Starts at frame 0 and ends at the timeline's last frame.",
      "additionalProperties": false,
      "required": ["src", "volume", "loop"],
      "properties": {
        "src": {
          "type": "string",
          "pattern": "^(?![/\\\\]).+$",
          "description": "Project-relative audio file (ADR-0006, ADR-0008)."
        },
        "volume": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Linear gain, above 0 and at most 1."
        },
        "loop": {
          "type": "boolean",
          "description": "The file repeats back to back until the timeline ends."
        },
        "fadeOutFrames": {
          "type": "integer",
          "minimum": 1,
          "description": "Linear fade to silence over the last N frames of the timeline. Absent means no fade."
        },
        "lengthFrames": {
          "type": "integer",
          "minimum": 1,
          "description": "The file length in frames at the project fps, written by the validator (stage 3). Absent in the filter output."
        }
      }
    }
  }
}
